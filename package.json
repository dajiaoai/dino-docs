{
  "name": "dino-open",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "大角几何开放平台 - SDK、协议层、文档站",
  "workspaces": [
    "demos/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run demos:build && npm run docs:build",
    "dev": "node scripts/dev.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "demos:build": "node scripts/build-demos.mjs",
    "demo:question-bank": "npm run dev --workspace @dino-open/demo-question-bank",
    "demo:smart-classroom": "npm run dev --workspace @dino-open/demo-smart-classroom"
  },
  "devDependencies": {
    "vitepress": "^1.6.0",
    "vue": "^3.4.0"
  },
  "engines": {
    "node": ">=18"
  }
}
